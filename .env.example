# OpenRouter API key, used by app/api/remix/route.ts for the real AI Remix.
# Get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# OpenRouter model id, in "<provider>/<model>" format, e.g. openai/gpt-4.1-mini
# Optional — if unset, the route falls back to a small default model.
OPENROUTER_MODEL=
